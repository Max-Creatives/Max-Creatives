# Copy to .env. Use a private managed PostgreSQL database in production.
DATABASE_URL="postgresql://max:CHANGE_ME@127.0.0.1:5432/max_outreach?schema=public"
APP_URL="http://localhost:3000"
# Used only by npm run auth:create. Never expose these with NEXT_PUBLIC_.
OWNER_EMAIL=""
OWNER_PASSWORD=""
# Optional: phone-only discovery. Add securely in your hosting dashboard.
BRAVE_SEARCH_API_KEY=""
# Per-workspace monthly search attempts, including retries. 0 disables searches.
RESEARCH_MONTHLY_SEARCH_LIMIT="50"
